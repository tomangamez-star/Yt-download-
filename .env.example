PORT=10000
API_RATE_LIMIT_PER_MINUTE=30
DOWNLOAD_RATE_LIMIT_PER_10_MIN=8
MAX_VIDEO_DURATION_SEC=7200
MAX_FILE_MB=750
YTDLP_TIMEOUT_MS=120000

# TubeGrab cloud download controller (Render only)
